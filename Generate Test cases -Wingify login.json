      "parameters": {
        "promptType": "define",
        "text": "=Generate comprehensive test cases for the Wingify (app.vwo.com)covering happy path scenarios, invalid inputs, edge cases, and user interactions.\n\nReturn ONLY a JSON array with objects containing:\n\"Test_ID\", \"Scenario\", \"Steps\", \"Expected_Result\", \"Status\"",
