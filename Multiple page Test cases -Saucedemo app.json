    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Generate comprehensive test cases for the SauceDemo {{ $json.module_name }} ({{ $json.url }}) covering happy path scenarios, edge cases, input validation, and expected UI behaviors.\n\nReturn ONLY a JSON array with objects containing:\n\"Test_ID\", \"Scenario\", \"Steps\", \"Expected_Result\", \"Status\"",
        "options": {
          "systemMessage": "You are a Senior QA Automation Engineer. Output strictly valid JSON without markdown tags."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -528,
        -960
      ],
      "id": "03c10809-d9e5-4ed7-b888-5508078146e7",
      "name": "Generate Test Cases Agent"
    },
    {
      "parameters": {
        "jsCode": "let rawOutput = $input.first().json.output || '';\n\n// Clean up markdown code fences (```json ... ```) if present\nrawOutput = rawOutput.replace(/```json\\s*/g, '').replace(/```\\s*/g, '').trim();\n\n// Fix truncated JSON if the LLM output was cut off mid-string\nif (!rawOutput.endsWith(']')) {\n  const lastObjectEnd = rawOutput.lastIndexOf('}');\n  if (lastObjectEnd !== -1) {\n    rawOutput = rawOutput.substring(0, lastObjectEnd + 1) + ']';\n  }\n}\n\nlet parsedData = [];\ntry {\n  parsedData = typeof rawOutput === 'string' ? JSON.parse(rawOutput) : rawOutput;\n} catch (e) {\n  // Fallback: If array parsing fails, return empty array to prevent complete workflow failure\n  console.error(\"Failed to parse JSON:\", e);\n}\n\nreturn parsedData.map(item => ({ json: item }));"
      },
